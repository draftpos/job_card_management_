<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FORM VIEW -->
    <record id="view_job_inventory_issue_form" model="ir.ui.view">
        <field name="name">job.inventory.issue.form</field>
        <field name="model">job.inventory.issue</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_populate_from_job_card" string="Populate from Job Card" type="object" class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_issue" string="Issue Inventory" type="object" class="btn-primary" invisible="state not in ('confirmed', 'partially_issued')"/>
                    <button name="action_create_requisitions" string="Create Requisitions" type="object" class="btn-warning" invisible="state not in ('confirmed', 'partially_issued')"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('issued', 'cancelled')"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,partially_issued,issued"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_picking" type="object" class="oe_stat_button" icon="fa-truck" invisible="not stock_picking_id">
                            <span class="o_stat_text">Transfer</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="job_card_id" readonly="state != 'draft'" domain="[('state', 'not in', ('draft', 'delivered', 'cancelled')), ('all_inventory_issued', '=', False)]"/>
                            <field name="customer_id"/>
                            <field name="vehicle_id"/>
                        </group>
                        <group>
                            <field name="issue_date" readonly="state != 'draft'"/>
                            <field name="source_location_id" readonly="state != 'draft'"/>
                            <field name="dest_location_id" readonly="state != 'draft'"/>
                            <field name="stock_picking_id" invisible="not stock_picking_id"/>
                            <field name="all_issued" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Issue Lines">
                            <field name="issue_line_ids" readonly="state == 'issued'">
                                <list editable="bottom" decoration-danger="shortage_qty &gt; 0">
                                    <field name="product_id" readonly="1"/>
                                    <field name="is_service" column_invisible="True"/>
                                    <field name="required_qty" readonly="1"/>
                                    <field name="available_qty"/>
                                    <field name="issued_qty" readonly="parent.state == 'issued'"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="balance_qty"/>
                                    <field name="shortage_qty" optional="show"/>
                                </list>
                            </field>
                            <group>
                                <field name="notes" placeholder="Additional notes..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_job_inventory_issue_list" model="ir.ui.view">
        <field name="name">job.inventory.issue.list</field>
        <field name="model">job.inventory.issue</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-info="state == 'draft'" decoration-warning="state == 'partially_issued'" decoration-success="state == 'issued'">
                <field name="name"/>
                <field name="job_card_id"/>
                <field name="customer_id"/>
                <field name="issue_date"/>
                <field name="source_location_id"/>
                <field name="state" widget="badge" decoration-muted="state == 'cancelled'" decoration-info="state == 'draft'" decoration-warning="state == 'partially_issued'" decoration-success="state == 'issued'"/>
            </list>
        </field>
    </record>

    <!-- SEARCH VIEW 
    <record id="view_job_inventory_issue_search" model="ir.ui.view">
        <field name="name">job.inventory.issue.search</field>
        <field name="model">job.inventory.issue</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="job_card_id"/>
                <field name="customer_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Issued" name="issued" domain="[('state', '=', 'issued')]"/>
                <group expand="0" string="Group By">
                    <filter string="Job Card" name="group_job" context="{'group_by': 'job_card_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    -->

    <!-- ACTION -->
    <record id="action_job_inventory_issue" model="ir.actions.act_window">
        <field name="name">Inventory Issues</field>
        <field name="res_model">job.inventory.issue</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
