<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_job_card" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.job.card</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Rename 'Unit Price' to 'Buying Price' -->
            <xpath expr="//field[@name='order_line']/list//field[@name='price_unit']" position="attributes">
                <attribute name="string">Buying Price</attribute>
            </xpath>
            
            <!-- Replace tax_totals widget with custom fields for totals -->
            <xpath expr="//field[@name='tax_totals']" position="replace">
                <group class="oe_subtotal_footer oe_right">
                    <field name="amount_untaxed" string="Total Excl"/>
                    <field name="amount_tax" string="Total Tax"/>
                    <div class="oe_subtotal_footer_separator oe_inline">
                        <label for="amount_total" string="Total Incl"/>
                    </div>
                    <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator"/>
                </group>
            </xpath>
            
            <!-- Add Terms and Conditions page -->
            <xpath expr="//notebook" position="inside">
                <page string="Terms and Conditions" name="terms_and_conditions">
                    <field name="notes" widget="html" nolabel="1"/>
                </page>
            </xpath>
            
            <!-- Hide Print buttons until approved -->
            <xpath expr="//button[@name='print_quotation']" position="attributes">
                <attribute name="invisible">state not in ('purchase', 'done')</attribute>
            </xpath>
            <xpath expr="//button[@name='%(purchase.action_report_purchase_order)d']" position="attributes">
                <attribute name="invisible">state not in ('purchase', 'done')</attribute>
            </xpath>
            <xpath expr="//button[@name='button_approve']" position="attributes">
                <attribute name="groups">job_card_management.group_can_approve_purchase_order</attribute>
            </xpath>
            <xpath expr="//button[@id='bid_confirm']" position="attributes">
                <attribute name="groups">job_card_management.group_can_approve_purchase_order</attribute>
            </xpath>
            <xpath expr="//button[@id='draft_confirm']" position="attributes">
                <attribute name="groups">job_card_management.group_can_approve_purchase_order</attribute>
            </xpath>
            
            <!-- Add Custom Buttons and Ribbon -->
            <xpath expr="//header" position="inside">
                <field name="has_done_picking" invisible="1"/>
                <field name="has_pending_picking" invisible="1"/>
                <button name="action_amend_supplier" string="Amend Supplier" type="object" invisible="state in ('done', 'cancel')"/>
                <button name="action_return_to_supplier_before_grv" string="Return to Supplier (Pre-GRV)" type="object" invisible="state in ('done', 'cancel') or has_done_picking" confirm="Are you sure you want to return/cancel this order before receiving goods?"/>
                <button name="action_return_to_supplier_after_grv" string="Return to Supplier (Post-GRV)" type="object" class="btn-warning" invisible="not has_done_picking or state == 'cancel'"/>
                <button name="action_manual_close" string="Close PO" type="object" class="btn-danger" invisible="state in ('done', 'cancel')"/>
            </xpath>

            <xpath expr="//sheet" position="before">
                <field name="is_amended" invisible="1"/>
                <widget name="web_ribbon" title="Amended" bg_color="text-bg-warning" invisible="not is_amended"/>
            </xpath>

            <xpath expr="//sheet//group[1]" position="after">
                <div class="alert alert-warning" role="alert" invisible="not is_amended" style="margin-bottom: 10px;">
                    <strong>Note:</strong> This Purchase Order was created as an amendment to another supplier.
                </div>
                <div class="alert alert-danger" role="alert" invisible="not closing_reason" style="margin-bottom: 10px;">
                    <strong>Closing Reason:</strong> <field name="closing_reason" readonly="1" class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_tree_inherit_job_card" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherit.job.card</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="is_amended" string="Amended" widget="boolean_toggle" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
